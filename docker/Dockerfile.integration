FROM rust:1-bookworm

RUN apt-get update \
  && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    postgresql postgresql-contrib procps netcat-openbsd ca-certificates gettext-base \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . .
RUN chmod +x /app/docker/integration-entrypoint.sh /app/docker/integration-restart-gateway.sh
RUN cargo build --release -p pg-gateway

ENV PG_GATEWAY_BIN=/app/target/release/pg-gateway

ENTRYPOINT ["/app/docker/integration-entrypoint.sh"]